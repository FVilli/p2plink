{
  "name": "@p2plink/demo-mesh",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal peer-to-peer mesh engine for the P2PLink demo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@p2plink/core": "link:../../packages/core",
    "@p2plink/crypto": "link:../../packages/crypto",
    "@p2plink/mqtt": "link:../../packages/mqtt",
    "@p2plink/webrtc": "link:../../packages/webrtc"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
