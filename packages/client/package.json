{
  "name": "@p2plink/client",
  "version": "0.1.0",
  "description": "Application-facing P2PLink client with WebRTC/MQTT fallback",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js", "require": "./dist/node.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "dependencies": {
    "@p2plink/core": "workspace:*",
    "@p2plink/crypto": "workspace:*",
    "@p2plink/mqtt": "workspace:*",
    "@p2plink/webrtc": "workspace:*"
  },
  "engines": { "node": ">=22" }
}
