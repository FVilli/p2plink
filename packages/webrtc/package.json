{
  "name": "@p2plink/webrtc",
  "version": "0.1.0",
  "description": "Runtime-abstracted WebRTC DataChannel transport for P2PLink",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js", "require": "./dist/node.cjs" },
    "./werift": { "types": "./dist/werift.d.ts", "import": "./dist/werift.js", "require": "./dist/werift.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "dependencies": { "@p2plink/core": "workspace:*" },
  "optionalDependencies": {
    "node-datachannel": "^0.33.5",
    "werift": "^0.25.2"
  },
  "engines": { "node": ">=22" }
}
