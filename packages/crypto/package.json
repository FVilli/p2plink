{
  "name": "@p2plink/crypto",
  "version": "0.1.0",
  "description": "WebCrypto-based identity, authenticated handshake and E2E frame protection for P2PLink",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "dependencies": { "@p2plink/core": "workspace:*" },
  "engines": { "node": ">=22" }
}
