{
  "name": "@p2plink/nestjs",
  "version": "0.1.0",
  "description": "NestJS dynamic module and typed handlers for P2PLink",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@p2plink/core": "^0.1.0",
    "@p2plink/server": "^0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "webrtc",
    "mqtt",
    "p2p",
    "rpc",
    "typescript",
    "fallback",
    "datachannel"
  ],
  "homepage": "https://github.com/FVilli/p2plink#readme",
  "bugs": {
    "url": "https://github.com/FVilli/p2plink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FVilli/p2plink.git",
    "directory": "packages/nestjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
