{
  "name": "@p2plink/angular",
  "version": "0.1.0",
  "description": "Angular signals and dependency-injection integration for P2PLink",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node ../../scripts/fix-angular-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@p2plink/client": "^0.1.0",
    "@p2plink/core": "^0.1.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "ng-packagr": "^22.2.5",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/fesm2022/p2plink-angular.mjs",
  "module": "./dist/fesm2022/p2plink-angular.mjs",
  "types": "./dist/types/p2plink-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/p2plink-angular.d.ts",
      "default": "./dist/fesm2022/p2plink-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "webrtc",
    "mqtt",
    "p2p",
    "rpc",
    "typescript",
    "fallback",
    "datachannel"
  ],
  "homepage": "https://github.com/FVilli/p2plink#readme",
  "bugs": {
    "url": "https://github.com/FVilli/p2plink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FVilli/p2plink.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  }
}
