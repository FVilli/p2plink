{
  "name": "@p2plink/example-browser-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx server.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@p2plink/client": "workspace:*",
    "@p2plink/core": "workspace:*",
    "@p2plink/crypto": "workspace:*",
    "@p2plink/mqtt": "workspace:*",
    "@p2plink/server": "workspace:*",
    "@p2plink/webrtc": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
